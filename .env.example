# Docker: port of the dashboard on the host
CLIENT_PORT=8080
# Optional build label shown in the header, e.g. BUILD_VERSION=$(git rev-parse --short HEAD)
BUILD_VERSION=

# Mock server (local dev; inside Docker the server always listens on 3001)
PORT=3001
# Reproduce client states: empty | error | slow | invalid (blank = normal mode)
MOCK_SCENARIO=
# Average delay between live patches in ms; each tick waits 50–150% of it
PATCH_INTERVAL_MS=2000

# AI search; without a key the table falls back to plain name search
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
